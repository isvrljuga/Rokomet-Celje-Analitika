rules_version = '2';
// Gledanje: vsi. Nove tekme: prijavljeni. Urejanje tekme: njen lastnik in skrbnik. Brisanje: samo skrbnik.
// Igralke osnovnih ekip in zavihke klubov ureja samo skrbnik.
// SKRBNIK_ID zamenjaj s svojim ID-jem (aplikacija ga pokaže v zavihku Izvoz po prijavi).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['mGyEsmEYYQYvgIVbFYFbReSeDRd2'];
    }
    match /games/{gameId} {
      allow read: if true;
      // Nova tekma pripada tistemu, ki jo ustvari; urejata jo lahko lastnik in skrbnik.
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner);
      allow delete: if isAdmin();
    }
    // Seznam igralk: članice, mladinke in kadetinje ureja samo skrbnik, ostale ekipe vsak prijavljen.
    match /rosters/{team} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.auth != null && !(team in ['members', 'juniors', 'cadets']));
      allow delete: if isAdmin();
    }
    // Zavihki klubov (config/teams): dodaja in ureja jih samo skrbnik.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
